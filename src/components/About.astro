---
import { getT, type Locale } from "../i18n/ui";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getT(lang).about;
const base = import.meta.env.BASE_URL + "/";

const tools = [
	{ name: "Clip Studio Paint", logo: `${base}tools/clip-studio.png` },
	{ name: "DaVinci Resolve", logo: `${base}tools/davinci-resolve.webp` },
	{ name: "Blender", logo: `${base}tools/blender.svg` },
	{ name: "Photoshop", logo: `${base}tools/photoshop.svg` },
];
---

<section class="section-shell relative overflow-hidden border-t border-ash bg-coal" id="about">
	<div
		class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-bronze/40 to-transparent"
	>
	</div>

	<div class="container">
		<div class="mb-10 flex flex-wrap items-end justify-between gap-6">
			<div class="max-w-xl space-y-4">
				<p class="eyebrow js-reveal">{t.eyebrow}</p>
				<h2
					class="display-title js-reveal text-4xl font-light leading-tight text-bone sm:text-5xl lg:text-6xl"
				>
					{t.title}
					<span class="italic text-bronze">{t.titleEm}</span>
					{t.titleAfter}
				</h2>
			</div>
		</div>

		<div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:gap-20">
			<!-- Bio -->
			<div class="space-y-6">
				<p
					class="js-reveal font-mono text-[0.72rem] uppercase tracking-[0.22em] text-stone/70"
				>
					{t.availability}
				</p>
				<p
					class="display-title js-reveal text-3xl font-light leading-tight text-bone sm:text-4xl"
				>
					{t.identity}
					<span class="italic text-bronze">— {t.role}</span>
				</p>
				<p class="js-reveal text-lg leading-relaxed text-stone md:text-lg">
					{t.bio1}
				</p>
				<p class="js-reveal text-lg leading-relaxed text-stone">
					{t.bio2}
				</p>
			</div>

			<!-- Tools -->
			<div class="js-reveal self-end border border-ash bg-carbon p-6">
				<p class="eyebrow mb-5">{t.toolsHeading}</p>
				<ul class="grid grid-cols-2 gap-2 sm:grid-cols-2">
					{
						tools.map((tool) => (
							<li class="group flex items-center gap-3 border border-smoke bg-coal px-4 py-3 transition-colors duration-200 hover:border-bronze">
								<img
									src={tool.logo}
									alt={`${tool.name} logo`}
									loading="lazy"
									decoding="async"
									class="h-5 w-5 shrink-0 opacity-80 transition-opacity duration-200 group-hover:opacity-100"
								/>
								<span class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-bone">
									{tool.name}
								</span>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Education & Experience -->
			<div class="space-y-10 lg:col-span-2">
				<div class="grid gap-10 md:grid-cols-2 lg:gap-20">
					<div class="js-reveal">
						<p class="eyebrow mb-6">{t.educationHeading}</p>
						<div class="border-t border-ash">
							{
								t.education.map((e) => (
									<div class="grid grid-cols-[auto_1fr] gap-6 border-b border-ash py-5">
										<span class="font-mono text-xs text-bronze">{e.year}</span>
										<div>
											<h3 class="font-mono text-xs uppercase tracking-[0.22em] text-bone">
												{e.title}
											</h3>
											<p class="mt-1 font-mono text-[0.72rem] uppercase tracking-[0.18em] text-stone">
												{e.org}
											</p>
											<p class="mt-2 text-lg leading-relaxed text-stone">
												{e.note}
											</p>
										</div>
									</div>
								))
							}
						</div>
					</div>

					<div class="js-reveal">
						<p class="eyebrow mb-6">{t.experienceHeading}</p>
						<div class="border-t border-ash">
							{
								t.experience.map((e) => (
									<div class="grid grid-cols-[auto_1fr] gap-6 border-b border-ash py-5">
										<span class="font-mono text-xs text-bronze">{e.year}</span>
										<div>
											<h3 class="font-mono text-xs uppercase tracking-[0.22em] text-bone">
												{e.title}
											</h3>
											<p class="mt-1 font-mono text-[0.72rem] uppercase tracking-[0.18em] text-stone">
												{e.org}
											</p>
											<p class="mt-2 text-lg leading-relaxed text-stone">
												{e.note}
											</p>
										</div>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
