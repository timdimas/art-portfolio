---
const { eyebrow, title, description } = Astro.props;
---

<div class="heading reveal">
  <span class="kicker">{eyebrow}</span>
  <h2>{title}</h2>
  <p>{description}</p>
</div>

<style>
  .heading {
    display: grid;
    gap: 18px;
    margin-bottom: 32px;
    max-width: 760px;
  }

  h2 {
    margin: 0;
    font-family: 'Fraunces', serif;
    font-size: clamp(2rem, 4vw, 3.8rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.75;
  }
</style>
