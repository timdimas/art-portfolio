---
import LanguageToggle from './LanguageToggle.astro';
import { getT, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getT(lang).header;
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-ash/60 bg-carbon/85 backdrop-blur-md">
  <div class="container flex items-center justify-between gap-6 py-5">
    <a href="#top" class="group flex items-center gap-3 font-mono text-lg uppercase tracking-[0.22em] text-bone">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-bronze transition-transform duration-200 group-hover:scale-125"></span>
      {t.name}
    </a>
    <div class="flex items-center gap-6">
      <nav class="hidden items-center gap-8 font-mono text-[0.8rem] uppercase tracking-[0.22em] text-stone sm:flex" aria-label={t.navLabel}>
        <a class="transition-colors duration-200 hover:text-bronze" href="#about">{t.nav.about}</a>
        <a class="transition-colors duration-200 hover:text-bronze" href="#work">{t.nav.work}</a>
        <a class="transition-colors duration-200 hover:text-bronze" href="#featured">{t.nav.featured}</a>
        <a class="transition-colors duration-200 hover:text-bronze" href="#contact">{t.nav.contact}</a>
      </nav>
      <LanguageToggle lang={lang} />
    </div>
  </div>
</header>
