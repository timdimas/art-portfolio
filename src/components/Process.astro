---
const stages = [
  {
    label: 'SKETCH',
    src: '/images/process-sketch.svg',
    caption: 'Gesture, rhythm, and block-in composition pass.',
  },
  {
    label: 'FLAT',
    src: '/images/process-flat.svg',
    caption: 'Shape lock, local color groups, and value hierarchy.',
  },
  {
    label: 'RENDER',
    src: '/images/process-render.svg',
    caption: 'Final paint pass with atmosphere and texture polish.',
  },
];
---

<section class="section-shell border-b border-line bg-paper-dark" id="process">
  <div class="container">
    <div class="mb-10 max-w-3xl space-y-4">
      <p class="eyebrow js-reveal">PROCESS BREAKDOWN</p>
      <h2 class="display-title js-reveal text-4xl text-ink sm:text-5xl lg:text-6xl">SKETCH TO FINAL FRAME</h2>
      <p class="js-reveal text-base leading-relaxed text-ink-soft md:text-lg">
        One hero shot shown as a three-stage breakdown to communicate intent, process, and final execution.
      </p>
    </div>

    <div class="js-reveal mb-4 hidden items-center text-[11px] font-semibold uppercase tracking-editorial text-sage-dark md:flex">
      <span>SKETCH</span>
      <span class="mx-4 h-px flex-1 border-t border-dotted border-sage"></span>
      <span>FLAT</span>
      <span class="mx-4 h-px flex-1 border-t border-dotted border-sage"></span>
      <span>RENDER</span>
    </div>

    <div class="grid grid-cols-1 border border-line md:grid-cols-3 md:gap-0">
      {
        stages.map((stage) => (
          <figure class="js-reveal border-b border-line bg-paper last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0">
            <img class="h-[320px] w-full object-cover md:h-[420px]" src={stage.src} alt={stage.label} loading="lazy" />
            <figcaption class="border-t border-line p-4">
              <p class="text-[11px] font-semibold uppercase tracking-editorial text-sage-dark">{stage.label}</p>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{stage.caption}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
