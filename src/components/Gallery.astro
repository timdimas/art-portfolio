---
import { format, getT, type Locale } from '../i18n/ui';
import { getGallery } from '../lib/frames';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getT(lang).gallery;
const frames = getGallery();

const rotations = [
  '-rotate-[1.6deg]', 'rotate-[2.2deg]', '-rotate-[0.8deg]', 'rotate-[1.2deg]',
  '-rotate-[2.4deg]', 'rotate-[0.6deg]', '-rotate-[1.1deg]', 'rotate-[2deg]',
];
const tapeEvery = [0, 3, 6];

const picks = frames.map((frame, i) => ({
  frame,
  rot: rotations[i % rotations.length],
  tape: tapeEvery.includes(i),
}));
---

<section class="section-shell relative overflow-hidden border-t border-ash bg-carbon" id="stills">
  <!-- light-table glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,#1E1A17_0%,#12100E_65%)]"></div>

  <div class="container relative">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl space-y-4">
        <p class="eyebrow js-reveal">{t.eyebrow}</p>
        <h2 class="display-title js-reveal text-4xl font-light leading-tight text-bone sm:text-5xl lg:text-6xl">
          {t.title} <span class="italic text-bronze">{t.titleEm}</span> {t.titleAfter}
        </h2>
        <p class="js-reveal text-lg leading-relaxed text-stone">
          {t.intro}
        </p>
      </div>
    </div>

    <div class="columns-2 gap-6 md:columns-3 lg:columns-4 lg:gap-8">
      {
        picks.map(({ frame, rot, tape }) => (
          <figure
            class={`js-reveal mb-6 break-inside-avoid transition-transform duration-500 ease-editorial hover:!rotate-0 hover:-translate-y-2 ${rot}`}
          >
            <div class="relative bg-bone p-3 pb-0 shadow-[0_12px_36px_rgba(0,0,0,0.55)] transition-shadow duration-500 ease-editorial hover:shadow-[0_22px_60px_rgba(0,0,0,0.65)]">
              {tape && (
                <span
                  class="pointer-events-none absolute -top-2.5 left-1/2 z-10 h-5 w-16 -translate-x-1/2 rotate-[-2deg] bg-[#C9A87C]/80 backdrop-blur-[1px]"
                  aria-hidden="true"
                ></span>
              )}
              <img
                src={frame.src}
                alt={format(t.alt, { timecode: frame.timecode })}
                loading="lazy"
                decoding="async"
                class="aspect-video w-full object-cover"
              />
              <figcaption class="flex items-baseline justify-between gap-3 py-2.5 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-carbon">
                {/* <span>ΚΑΡΕ {frame.index}</span>
                <span class="text-bronze-dark">TC {frame.timecode}</span> */}
              </figcaption>
            </div>
          </figure>
        ))
      }
    </div>

  </div>
</section>
