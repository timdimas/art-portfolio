---
import { getT, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getT(lang).pipeline;
const base = import.meta.env.BASE_URL + '/';
---

<section class="relative overflow-hidden border-t border-ash bg-coal" id="pipeline">
  <!-- city.jpg full-bleed background -->
  <div class="absolute inset-0">
    <img
      src={`${base}pipeline/city.jpg`}
      alt={t.bgAlt}
      class="h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <!-- contrast scrim: light on the left, deep carbon on the right where the text sits -->
    <div class="absolute inset-0 bg-gradient-to-r from-carbon/40 via-carbon/75 to-carbon/95"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-carbon/80 via-transparent to-carbon/40"></div>
  </div>

  <div class="container relative py-20 md:py-28">
    <div class="ml-auto max-w-xl lg:max-w-2xl">
      <p class="eyebrow js-reveal text-bone/70">{t.eyebrow}</p>
      <h2 class="display-title js-reveal mt-4 text-4xl font-light leading-tight text-bone sm:text-5xl lg:text-6xl">
        {t.title} <span class="italic text-bronze">{t.titleEm}</span> {t.titleAfter}
      </h2>
      <p class="js-reveal mt-4 text-lg leading-relaxed text-bone/80">
        {t.intro}
      </p>

      <ol class="mt-10 border-t border-bone/15">
        {
          t.stages.map((stage) => (
            <li class="js-reveal grid grid-cols-[auto_1fr] gap-6 border-b border-bone/15 py-6">
              <span class="display-title text-3xl font-light italic text-bronze/80">{stage.id}</span>
              <div>
                <h3 class="font-mono text-sm uppercase tracking-[0.22em] text-bone">{stage.label}</h3>
                <p class="mt-1 font-mono text-[0.72rem] uppercase tracking-[0.22em] text-bone/60">{stage.tool}</p>
                <p class="mt-3 text-lg leading-relaxed text-bone/80">{stage.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="js-reveal mt-6 font-mono text-[0.72rem] uppercase tracking-[0.22em] text-bone/50">
        {t.footnote}
      </p>
    </div>
  </div>
</section>
