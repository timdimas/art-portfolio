---
import { getT, type Locale } from "../i18n/ui";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getT(lang).footer;
---

<footer class="relative overflow-hidden border-t border-ash bg-carbon" id="contact">
	<div class="container py-16">
		<div class="flex items-center gap-4">
			<span class="h-px flex-1 bg-ash"></span>
			<p class="font-mono text-[0.72rem] uppercase tracking-[0.22em] text-stone">
				{t.endLabel}
			</p>
			<span class="h-px flex-1 bg-ash"></span>
		</div>

		<div class="mt-12 grid gap-10 text-center lg:grid-cols-2 lg:text-left">
			<div class="lg:pr-8">
				<p class="eyebrow mb-3">{t.creatorHeading}</p>
				<p class="display-title text-3xl font-light text-bone">
					{t.name}
					<span class="italic text-bronze">{t.nameEm}</span>
				</p>
				<p class="mt-2 text-lg leading-relaxed text-stone">
					2D/3D Animator · Concept Artist · Sound Designer.
				</p>
			</div>

			<div>
				<p class="eyebrow mb-3">{t.contactHeading}</p>
				<ul class="space-y-2 font-mono text-sm text-stone">
					<li>
						<a
							class="text-bone underline-offset-4 transition-colors duration-200 hover:text-bronze hover:underline"
							href="mailto:panosvasdaris@gmail.com">Email: panosvasdaris@gmail.com</a
						>
					</li>
					<li>
						<a
							class="text-bone underline-offset-4 transition-colors duration-200 hover:text-bronze hover:underline"
							href="https://instagram.com"
							target="_blank"
							rel="noreferrer">Instagram: -</a
						>
					</li>
					<li>
						<a
							class="text-bone underline-offset-4 transition-colors duration-200 hover:text-bronze hover:underline"
							href="https://behance.net"
							target="_blank"
							rel="noreferrer">Behance: -</a
						>
					</li>
				</ul>
			</div>

			<!-- <div>
				<p class="eyebrow mb-3">CREDITS</p>
				<p class="max-w-xs font-mono text-xs leading-relaxed text-stone lg:ml-auto">
					{t.creditsText}
				</p>
			</div> -->
		</div>

		<!-- <p
			class="mt-12 text-center font-mono text-[0.72rem] uppercase tracking-[0.22em] text-stone/60"
		>
			{t.copyright}
		</p> -->
	</div>
</footer>
