---
import { getT, type Locale } from "../i18n/ui";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getT(lang).featured;
---

<section class="relative overflow-hidden border-t border-ash bg-coal" id="featured">
	<div
		class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-bronze/40 to-transparent"
	>
	</div>

	<div class="container py-16 md:py-20">
		<div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
			<div class="max-w-2xl space-y-4">
				<p class="eyebrow js-reveal">{t.eyebrow}</p>
				<h2
					class="display-title js-reveal text-4xl font-light leading-tight text-bone sm:text-5xl lg:text-6xl"
				>
					{t.title}
					<span class="italic text-bronze">{t.titleEm}</span>
					{t.titleAfter}
				</h2>
				<p
					class="js-reveal font-mono text-[0.75rem] uppercase tracking-[0.22em] text-stone"
				>
					{t.subtitle}
				</p>
			</div>

			<!-- <div
				class="js-reveal shrink-0 font-mono text-[0.75rem] uppercase tracking-[0.22em] leading-loose text-stone"
			>
				{t.aside.map((line) => <p>{line}</p>)}
			</div> -->
		</div>
	</div>
</section>
