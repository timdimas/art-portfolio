---
import { getT, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const toggle = getT(lang).toggle;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const href = lang === 'el' ? `${base}/en/` : `${base}/`;
const otherHreflang = lang === 'el' ? 'en' : 'el';
---

<a
  href={href}
  hreflang={otherHreflang}
  aria-label={toggle.aria}
  class="inline-flex shrink-0 items-center border border-ash px-3 py-1.5 font-mono text-[0.72rem] uppercase tracking-[0.22em] text-bone transition-colors duration-200 hover:border-bronze hover:text-bronze"
>
  {toggle.label}
</a>
