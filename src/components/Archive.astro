---
import { getT, type Locale } from "../i18n/ui";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getT(lang).archive;
const base = import.meta.env.BASE_URL + "/";
---

<section class="section-shell border-t border-ash bg-carbon" id="work">
	<div class="container">
		<div class="mx-auto max-w-xl text-center pt-2">
			<p class="eyebrow js-reveal">{t.eyebrow}</p>
			<h2
				class="display-title js-reveal text-4xl font-light leading-tight text-bone sm:text-5xl lg:text-6xl"
			>
				{t.title}
				<span class="italic text-bronze">{t.titleEm}</span>
				{t.titleAfter}
			</h2>
			<p class="js-reveal text-lg leading-relaxed text-stone">
				{t.intro}
			</p>
		</div>

		<figure class="js-reveal group relative mx-auto mt-14 w-full max-w-sm">
			<div
				class="relative bg-bone p-3 pb-0 shadow-[0_18px_50px_rgba(0,0,0,0.6)] transition-shadow duration-500 ease-editorial group-hover:shadow-[0_28px_72px_rgba(0,0,0,0.7)]"
			>
				<span
					class="pointer-events-none absolute -top-2.5 left-1/2 z-10 h-5 w-16 -translate-x-1/2 rotate-[-2deg] bg-[#C9A87C]/80 backdrop-blur-[1px]"
					aria-hidden="true"></span>
				<img
					src={`${base}images/Poster.webp`}
					alt={t.posterAlt}
					loading="lazy"
					decoding="async"
					class="aspect-[3/4] w-full object-cover"
				/>
				<figcaption
					class="py-2.5 text-center font-mono text-[0.68rem] uppercase tracking-[0.14em] text-carbon"
				>
					{t.posterCaption}
					<span class="text-bronze-dark">{t.posterCaptionEm}</span>
				</figcaption>
			</div>
		</figure>
	</div>
</section>
